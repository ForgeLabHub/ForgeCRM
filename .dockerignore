# Keep the build context small and free of secrets and local artefacts.
# The root Dockerfile builds both the Go binaries and the web interface, so
# everything here that is rebuilt inside the image is excluded from the context.

# Version control and editor state.
#
# .git is deliberately NOT excluded: the `buildmeta` stage of the root Dockerfile
# reads the checked-out revision from it so /ready reports the commit actually
# built, rather than a hand-maintained environment variable that goes stale. The
# runtime image never copies .git; only the throwaway buildmeta stage sees it.
.gitignore
.github
.idea
.vscode

# Secrets and local configuration. .env holds FORGECRM_SECRET_KEY.
.env
.env.*
!.env.example
*.local

# Backups and dumps contain real data.
backups
*.dump
*.sql.gz

# Web dependencies and build output are rebuilt in the image.
frontend/node_modules
frontend/dist
frontend/.vite
frontend/test-results
frontend/playwright-report
frontend/blob-report
*.tsbuildinfo

# Go build output and test artefacts.
backend/bin
*.test
*.out
coverage.out
coverage.html

# Agent and build scratch.
.agent_tmp
.run
__pycache__
*.pyc

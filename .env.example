# ForgeCRM deployment configuration.
# Copy to .env and fill in. Every value here is a development default and is
# NOT safe for production: see docs/deployment for the production checklist.
#
# Every variable, its component, default and whether it is a secret is documented
# in docs/deployment/environment-variables.md.

# --- Core -------------------------------------------------------------------
# "development" enables dev conveniences such as returning reset tokens in API
# responses. Never use it in production.
FORGECRM_ENV=development
FORGECRM_HTTP_ADDR=:8080
# Public origin. In production this must be https. When it is empty, the hosting
# platform's own URL (RENDER_EXTERNAL_URL) is used before the localhost default,
# so a Blueprint deploy starts without hardcoding a hostname.
FORGECRM_BASE_URL=http://localhost:8080
FORGECRM_LOG_LEVEL=info
FORGECRM_LOG_FORMAT=json
FORGECRM_MIGRATE_ON_START=true
# Directory holding the built web interface. The root Dockerfile copies the
# bundle to /app/public and sets this; the default is "public" relative to the
# working directory. Leave empty when the API serves only JSON.
FORGECRM_STATIC_DIR=/app/public
# Selects the binary the image entrypoint runs. Unset means the API; "worker"
# starts the background worker. Docker Compose sets it on the worker service.
# FORGECRM_ROLE=worker
# Build metadata. These are fallbacks for hosts that do not pass linker flags at
# build time (FORGECRM_VERSION / FORGECRM_COMMIT build args). The API reports the
# effective values through /ready and the startup log; an unset value shows as
# 0.1.0-dev / unknown. On Render the commit also falls back to RENDER_GIT_COMMIT.
FORGECRM_VERSION=
FORGECRM_COMMIT=

# --- Database ---------------------------------------------------------------
FORGECRM_DATABASE_URL=postgres://forgecrm:forgecrm@postgres:5432/forgecrm?sslmode=disable
# Some platforms inject the connection string as DATABASE_URL instead; the API
# accepts either name. FORGECRM_DATABASE_URL wins when both are set.
# DATABASE_URL=
#
# The POSTGRES_* variables are read only by docker-compose.yml to create the
# database container; the API itself never reads them.
POSTGRES_USER=forgecrm
POSTGRES_PASSWORD=forgecrm
POSTGRES_DB=forgecrm

# Connections one process may hold. The number that matters is
# replicas x this value, and it must stay below the server's max_connections
# (PostgreSQL defaults to 100, with a few reserved for superusers). Values above
# 25 are refused at startup rather than clamped, because a silently reduced pool
# shows up later as unexplained timeouts under load.
FORGECRM_DATABASE_MAX_CONNS=16

# --- Secrets ----------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 48
# This key encrypts integration credentials at rest. Losing it makes stored
# integration secrets unrecoverable.
FORGECRM_SECRET_KEY=

# Protects /metrics. Leave empty to serve metrics only to authenticated admins.
FORGECRM_METRICS_TOKEN=

# --- Sessions and rate limiting --------------------------------------------
FORGECRM_SESSION_TTL=12h
FORGECRM_SESSION_COOKIE=forgecrm_session
# Cookie domain, for sharing a session across subdomains. Empty means host-only.
FORGECRM_COOKIE_DOMAIN=
FORGECRM_CSRF_HEADER=X-CSRF-Token
FORGECRM_COOKIE_SECURE=false
FORGECRM_RATE_LIMIT_PER_MIN=300
# Authentication attempts allowed per client IP per minute. Raise this when many
# users share one address (an office behind a single NAT gateway), because they
# all consume the same bucket.
FORGECRM_LOGIN_RATE_LIMIT_PER_MIN=60

# --- Rate limit counters ----------------------------------------------------
# "memory" keeps counters in the process. Each replica then enforces its own
# budget, so the effective limit is the configured value times the number of
# replicas. That is fine for a single API container, which is the default.
#
# "redis" shares counters across replicas, so the configured budget is the
# budget. It requires FORGECRM_REDIS_URL, and the API refuses to start if the
# server cannot be reached rather than running with the limit unenforced.
FORGECRM_RATE_LIMIT_STORE=memory
# Example: redis://:password@redis:6379/0
FORGECRM_REDIS_URL=

# --- Reverse proxy trust ----------------------------------------------------
# Comma-separated CIDRs (or single addresses) of proxies whose forwarding
# headers may be believed. Leave empty unless a proxy sits in front of the API.
#
# This setting is a security boundary, not a convenience. X-Forwarded-For is a
# request header, so any client can set it. When the peer is not in this list the
# header is ignored and the connection's own address is used. With an empty list
# every request is attributed to its connection address, which is the safe
# default. Trusting every peer ("*") lets any caller choose the address it is
# counted and logged under, so it is only correct when the API cannot be reached
# except through the proxy.
FORGECRM_TRUSTED_PROXIES=
FORGECRM_LOCKOUT_THRESHOLD=8
FORGECRM_LOCKOUT_WINDOW=15m

# --- Import Center limits ---------------------------------------------------
# Upload ceiling, total unpacked size, entry count, nesting depth and the
# maximum tolerated compression ratio (a zip-bomb guard).
FORGECRM_IMPORT_MAX_UPLOAD_BYTES=268435456
FORGECRM_IMPORT_MAX_UNPACKED_BYTES=2147483648
FORGECRM_IMPORT_MAX_ARCHIVE_FILES=5000
FORGECRM_IMPORT_MAX_ARCHIVE_DEPTH=8
FORGECRM_IMPORT_MAX_RATIO=200
FORGECRM_IMPORT_BATCH_SIZE=500
FORGECRM_IMPORT_STORAGE_DIR=/var/lib/forgecrm/imports
FORGECRM_IMPORT_TEMP_DIR=/var/lib/forgecrm/tmp

# --- Background jobs --------------------------------------------------------
FORGECRM_WORKER_CONCURRENCY=4
FORGECRM_WORKER_POLL=2s
# How long the worker waits for an in-flight job after SIGTERM before it abandons
# it. Keep docker-compose's stop_grace_period above this value.
FORGECRM_WORKER_SHUTDOWN_GRACE=30s
# NOTE: read by the code but not currently used. See
# docs/deployment/environment-variables.md#declared-but-unused.
FORGECRM_JOB_MAX_ATTEMPTS=5

# --- Data retention (optional, opt-in) --------------------------------------
# Retention is off unless it is enabled, and even when enabled it defaults to a
# dry run: the sweep reports the rows a real run would remove and deletes nothing
# until FORGECRM_RETENTION_DRY_RUN is set to false. Nothing is swept without a
# policy, and the policy catalog lives in internal/retention.
FORGECRM_RETENTION_ENABLED=false
FORGECRM_RETENTION_DRY_RUN=true
# Audit and security evidence (audit_log, security_events, login_attempts) is
# only swept when this is true, because deleting the record of who did what is
# exactly what an attacker with database access would do.
FORGECRM_RETENTION_ALLOW_AUDIT=false
# Per-policy window overrides as key=duration pairs, comma-separated. An unknown
# key is refused at startup rather than ignored. Keys include the transient rows:
# oidc_login_states_expired, password_reset_tokens_expired, email_log_settled.
FORGECRM_RETENTION_WINDOWS=

# --- Bootstrap administrator (first run only) -------------------------------
# Creates the first platform administrator. Both values must be set together, or
# neither. The account is created only when no platform owner exists, so leaving
# these set does NOT overwrite an existing owner and is safe but pointless after
# the first run. Prefer passing the password through the environment to the
# dedicated command so it never lands in the process list:
#
#   FORGECRM_BOOTSTRAP_ADMIN_PASSWORD='...' docker compose run --rm --no-deps \
#     api --bootstrap-admin --bootstrap-email you@example.com
#
# FORGECRM_BOOTSTRAP_PASSWORD is the older name and is still accepted.
FORGECRM_BOOTSTRAP_ADMIN_EMAIL=
FORGECRM_BOOTSTRAP_ADMIN_PASSWORD=

# --- Email (optional) -------------------------------------------------------
# SMTP is disabled unless explicitly enabled. Verifying the connection is not
# the same as delivering mail.
FORGECRM_SMTP_ENABLED=false
FORGECRM_SMTP_HOST=
FORGECRM_SMTP_PORT=587
FORGECRM_SMTP_USERNAME=
FORGECRM_SMTP_PASSWORD=
FORGECRM_SMTP_FROM=no-reply@example.com
FORGECRM_SMTP_FROM_NAME=ForgeCRM
FORGECRM_SMTP_STARTTLS=true
FORGECRM_SMTP_TLS=false
FORGECRM_SMTP_TIMEOUT=15s
# NOTE: read by the code but not currently used. See
# docs/deployment/environment-variables.md#declared-but-unused.
FORGECRM_SMTP_PUBLIC_URL=

# --- Telegram (optional) ----------------------------------------------------
# With no token the bot stays off and the rest of the platform is unaffected.
FORGECRM_TELEGRAM_ENABLED=false
FORGECRM_TELEGRAM_BOT_TOKEN=
# NOTE: read by the code but not currently used. See
# docs/deployment/environment-variables.md#declared-but-unused.
FORGECRM_TELEGRAM_WEBHOOK_SECRET=

# --- AI (optional) ----------------------------------------------------------
# The platform runs fully without a model provider. "ollama" keeps prompts local.
FORGECRM_AI_ENABLED=false
FORGECRM_AI_PROVIDER=ollama
FORGECRM_AI_BASE_URL=http://ollama:11434
FORGECRM_AI_MODEL=llama3.1
FORGECRM_AI_API_KEY=
FORGECRM_AI_TIMEOUT=60s
FORGECRM_AI_MAX_REQUESTS_PER_MIN=60

# --- Object storage for attachments (optional) ------------------------------
# Any S3-compatible server: AWS S3, MinIO, Ceph RGW, Backblaze B2, Wasabi.
# Leave FORGECRM_STORAGE_ENABLED=false and the document routes answer 503;
# the capabilities endpoint reports storage: false so the UI hides uploads.
FORGECRM_STORAGE_ENABLED=false
FORGECRM_STORAGE_ENDPOINT=
FORGECRM_STORAGE_REGION=us-east-1
FORGECRM_STORAGE_BUCKET=forgecrm-attachments
FORGECRM_STORAGE_ACCESS_KEY_ID=
FORGECRM_STORAGE_SECRET_ACCESS_KEY=
# MinIO and most self-hosted gateways need path-style addressing.
FORGECRM_STORAGE_USE_PATH_STYLE=true
# Keep false for a public cloud endpoint. Set true only to reach a MinIO on a
# private network: the endpoint is operator-supplied and is treated as an SSRF
# target otherwise.
FORGECRM_STORAGE_ALLOW_PRIVATE_ENDPOINT=false
FORGECRM_STORAGE_MAX_OBJECT_BYTES=67108864
FORGECRM_STORAGE_PRESIGN_TTL=15m
FORGECRM_STORAGE_TIMEOUT=30s
# The worker repairs a disagreement between the store and the documents table on
# the hourly maintenance tick: a row whose object is gone is archived, and an
# object no row references is removed once it is older than the grace period. It
# only deletes when retention is opted out of its dry run, so a deployment that
# has not enabled deletion never loses an object to it.

# --- Enterprise SSO (optional) ---------------------------------------------
FORGECRM_OIDC_ENABLED=false
FORGECRM_OIDC_ISSUER=
FORGECRM_OIDC_CLIENT_ID=
FORGECRM_OIDC_CLIENT_SECRET=
FORGECRM_OIDC_REDIRECT_URL=
FORGECRM_OIDC_SCOPES=openid,email,profile

# --- MCP client credentials (optional) -------------------------------------
# The MCP protocol endpoint (/api/v1/mcp) accepts a session cookie or an
# `Authorization: Bearer fcmcp_...` credential minted under
# /api/v1/mcp/credentials. The budget below bounds tool calls made with one
# credential, per minute; 0 disables the limit. Credentials are always
# narrower than their owner: a token carries an explicit permission list.
FORGECRM_MCP_REQUESTS_PER_MIN=120
